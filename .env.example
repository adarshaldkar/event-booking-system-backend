# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=4000

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Local (Docker):
DATABASE_URL="postgresql://postgres:password@localhost:5432/event_booking_db?schema=public"
# Cloud (Neon/Supabase) — replace for deployment:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ==========================================
# REDIS & QUEUE (BullMQ)
# ==========================================
# Local (Docker):
REDIS_URL="redis://localhost:6379"
# Cloud (Upstash) — replace for deployment:
# REDIS_URL="rediss://default:password@hostname.upstash.io:6380"

# ==========================================
# SECURITY
# ==========================================
# IMPORTANT: Must be at least 32 characters in production!
JWT_SECRET="change-this-to-a-very-secure-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"
QR_SIGNING_SECRET="change-this-to-a-secure-qr-signing-secret-key-32-chars"

# ==========================================
# EMAIL DELIVERY
# ==========================================
# Set EMAIL_PROVIDER to "resend" or "smtp"
EMAIL_PROVIDER="resend"

# --- Resend API (recommended — free 3000/month) ---
RESEND_API_KEY="re_your_resend_api_key_here"

# --- SMTP (Gmail alternative) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"

# Sender name/address shown in emails
EMAIL_FROM="Event Booking System <onboarding@resend.dev>"
